# Supabase configuration for Haven (Phase 2).
#
# Copy this file to .env.local for local development. Set the same variable
# names in Vercel for the preview deployment. Never commit real values:
# .env* files are gitignored, and .env.example is the single committed
# exception (see .gitignore).

# ---------------------------------------------------------------------------
# Public values — safe to expose. Next.js inlines NEXT_PUBLIC_* variables
# into both server and browser bundles at build time.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# ---------------------------------------------------------------------------
# Server-only secret. NEVER prefix this with NEXT_PUBLIC_ — Next.js would
# inline the value into every browser bundle. Read exclusively by
# lib/supabase/admin.ts for trusted administrative operations; guarded by
# ESLint and verified against real build output by
# tests/bundle/client-bundle-secrets.test.ts.
# ---------------------------------------------------------------------------
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Optional alias read by operator scripts (falls back to
# NEXT_PUBLIC_SUPABASE_URL when unset).
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
